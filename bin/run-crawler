#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Request a price crawler run from the trusted default branch.

Usage:
  MODEL=<openai|anthropic|google> bin/run-crawler

The script reads GITHUB_API_TOKEN from .env at the repository root and sends a
repository_dispatch event to GitHub. It never prints the token.

Only repository administrators can manually run workflows at this time. Ask a
repository administrator if you need a crawler run and do not have that role.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

MODEL="${MODEL:-}"

case "$MODEL" in
  openai|anthropic|google)
    ;;
  '')
    echo "MODEL is required." >&2
    usage >&2
    exit 1
    ;;
  *)
    echo "Unsupported MODEL: $MODEL" >&2
    echo "Supported values: openai, anthropic, google." >&2
    exit 1
    ;;
esac

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
ENV_FILE="$REPO_ROOT/.env"

if [[ ! -r "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE. Copy .env.example to .env and set GITHUB_API_TOKEN." >&2
  exit 1
fi

# Read only the expected variable instead of sourcing executable shell content
# from .env. Tokens produced by GitHub do not contain whitespace or equals signs.
GITHUB_API_TOKEN="$(awk -F= '$1 == "GITHUB_API_TOKEN" { sub(/^[^=]*=/, ""); print; exit }' "$ENV_FILE")"

if [[ -z "$GITHUB_API_TOKEN" ]]; then
  echo "GITHUB_API_TOKEN must be set in $ENV_FILE." >&2
  exit 1
fi

echo "Requesting the $MODEL crawler from the trusted default branch..."

curl --fail-with-body -L -X POST \
  -H "Accept: application/vnd.github+json" \
  -H "Authorization: Bearer $GITHUB_API_TOKEN" \
  -H "X-GitHub-Api-Version: 2026-03-10" \
  https://api.github.com/repos/ArtemAtGusto/token-costs/dispatches \
  -d "{\"event_type\":\"crawl-$MODEL\"}"

echo "Crawler request accepted. See GitHub Actions for the run status."
