{
  "name": "token-costs",
  "version": "3.0.0",
  "description": "Crawlers for tracking LLM token pricing",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "crawl:dev:openai": "npm run build && npm run crawl:openai",
    "crawl:dev:anthropic": "npm run build && npm run crawl:anthropic",
    "crawl:dev:google": "npm run build && npm run crawl:google",
    "crawl:dev:all": "npm run build && npm run crawl:all",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "crawl:openai": "node --experimental-vm-modules dist/crawlers/openai/index.js",
    "crawl:anthropic": "node --experimental-vm-modules dist/crawlers/anthropic/index.js",
    "crawl:google": "node --experimental-vm-modules dist/crawlers/google/index.js",
    "crawl:all": "npm run crawl:openai && npm run crawl:anthropic && npm run crawl:google",
    "show:openai": "node -e \"const fs=require('fs');const d=JSON.parse(fs.readFileSync('./docs/api/v1/openai.json','utf8'));console.log(JSON.stringify(d,null,2));\"",
    "show:anthropic": "node -e \"const fs=require('fs');const d=JSON.parse(fs.readFileSync('./docs/api/v1/anthropic.json','utf8'));console.log(JSON.stringify(d,null,2));\"",
    "show:google": "node -e \"const fs=require('fs');const d=JSON.parse(fs.readFileSync('./docs/api/v1/google.json','utf8'));console.log(JSON.stringify(d,null,2));\"",
    "test:local": "npm run build && node --experimental-vm-modules dist/test-local.js",
    "test:local:openai": "npm run build && node --experimental-vm-modules dist/test-local.js openai",
    "test:local:anthropic": "npm run build && node --experimental-vm-modules dist/test-local.js anthropic",
    "test:local:google": "npm run build && node --experimental-vm-modules dist/test-local.js google",
    "test:local:show": "npm run build && node --experimental-vm-modules dist/test-local.js --show"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikkotikkanen/token-costs.git"
  },
  "bugs": {
    "url": "https://github.com/mikkotikkanen/token-costs/issues"
  },
  "keywords": [
    "llm",
    "pricing",
    "openai",
    "anthropic",
    "google",
    "gpt",
    "claude",
    "gemini",
    "tokens",
    "cost"
  ],
  "author": "Mikko Tikkanen",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.62.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
